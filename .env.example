# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# RAMAX Configurable Domains (changeable without editing source code)
RAMAX_MAIN_DOMAIN="ramax.ramalife.cloud"
RAMAX_AI_DOMAIN="ai.ramalife.cloud"
RAMAX_PANEL_DOMAIN="panel.ramax.ramalife.cloud"
RAMAX_CONTROL_DOMAIN="control.ramax.ramalife.cloud"

# RAMAX Legal Identity Settings (pending owner confirmation before publishing as official)
RAMAX_LEGAL_NAME="فاضل رایانه"
RAMAX_LEGAL_WEBSITE="fazelcomputer.ir"
RAMAX_LEGAL_CONFIRMED="false"
RAMAX_CONTACT_EMAIL="support@ramalife.cloud"
RAMAX_CONTACT_PHONE=""

# Session Secrets (auto-generated fallback in dev if omitted)
RAMAX_CUSTOMER_SESSION_SECRET=""
RAMAX_ADMIN_SESSION_SECRET=""
RAMAX_WEBHOOK_SIGNING_SECRET=""

# Optional ArvanCloud AI Provider Adapter (disabled until configured)
ARVAN_AI_BASE_URL=""
ARVAN_AI_API_KEY=""
